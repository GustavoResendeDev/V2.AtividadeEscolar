# Só para rodar os scripts do banco no seu computador (npm run migrar / npm run usuario).
# Em produção, estes valores ficam nos segredos do GitHub (veja DEPLOY.md). Nunca suba o .env para o Git.
# Supabase > Connect > Session pooler (porta 5432):
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@seudominio.com.br
ADMIN_SENHA=troque-por-uma-senha-forte
