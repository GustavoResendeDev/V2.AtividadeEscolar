{
  "name": "nova-era-barbearia",
  "version": "2.1.0",
  "description": "Sistema de agendamento da Nova Era Barbearia: site institucional, agendamento online e painel do barbeiro. Produção: Cloudflare Worker + Supabase.",
  "private": true,
  "main": "server/worker.mjs",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test \"tests/unit/*.test.js\" \"tests/api/*.test.js\"",
    "test:e2e": "node --test \"tests/e2e/*.test.js\"",
    "migrar": "node --env-file-if-exists=.env scripts/migrar.js",
    "usuario": "node --env-file-if-exists=.env scripts/criar-usuario.js",
    "deploy": "wrangler deploy",
    "dev:worker": "wrangler dev",
    "build": "node scripts/montar-site.mjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "hono": "4.13.16",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@hono/node-server": "1.19.18",
    "esbuild": "0.28.2",
    "wrangler": "4.157.0"
  }
}
