# Cabeçalhos que a Cloudflare aplica às páginas e arquivos de public/ (a API define os seus em server/app.js).
# Mantenha igual a CABECALHOS_SEGURANCA em server/app.js: o teste tests/unit/cabecalhos.test.js confere.
/*
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; media-src 'self'; style-src 'self'; script-src 'self'; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000

# CSS e JS: o HTML aponta para eles com ?v=<impressão digital> (scripts/montar-site.mjs),
# então podem ficar guardados por 1 ano; qualquer mudança gera um endereço novo.
/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/image/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/video/*
  Cache-Control: public, max-age=604800
